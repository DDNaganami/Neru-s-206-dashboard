.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
preview/frames/
preview/frames_demo/

# 预览时临时放的主题文件与运行日志（自己的主题请另存别处）
# 注意:注释符是 #,不是 ; —— gitignore 不认分号,写成分号那几行等于没生效
preview/theme-broken.json
preview/theme-trunc.json
preview/run*.log
preview/run*.err

# Python 编译缓存(2026-09-18:之前被 git add -A 误带进仓库过一次)
__pycache__/
*.pyc

# ★ 钥匙类文件绝不允许进仓库（2026-09-21：有一次私钥被放进了 tools/ 共享目录，靠人工发现）
id_*
*.key
dsh_*
known_hosts*
# ★ 车主本地产物（2026-09-24）：导出/导入的文件不提交 —— 美术资产的许可是
#   "保留所有权利"，误提交会让 LICENSE-ARTWORK 的声明与仓库内容不符。
#   主题文件仍留在 tools/theme-editor/theme.json（试跑与页面按路径找它），只是隐掉状态。
/tools/theme-editor/local/*
!/tools/theme-editor/local/README.md
/tools/theme-editor/theme.json
